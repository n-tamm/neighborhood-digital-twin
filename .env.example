# Copy this file to .env for local development. Never commit the populated file.

CENSUS_API_KEY=
FRED_API_KEY=

# Prefer the Databricks CLI profile when possible. These are placeholders for
# development paths that explicitly require environment-based authentication.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Application configuration
NDT_ENV=development
NDT_CONFIG_DIR=configs
NDT_DATA_DIR=data
NDT_ARTIFACT_DIR=artifacts/local
